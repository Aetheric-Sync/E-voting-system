// Target Postgres schema for @evote/api
// Anonymity rules:
//   1. Ballot has NO relation to Voter and NO timestamp column.
//   2. Participation has NO relation to Ballot.
//   3. commitVote = one SERIALIZABLE transaction (check eligibility, participation insert + ballot insert + audit append).
//   4. AuditLog is append-only: unique(electionId, seq) prevents forks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrityMode {
  ANONYMOUS_AUDIT
  E2E_VERIFIABLE
}

enum ElectionState {
  DRAFT
  OPEN
  CLOSED
  SEALED
}

enum BallotType {
  SINGLE
  MULTI
  APPROVAL
  RANKED
  REFERENDUM
}

enum StaffRole {
  ADMIN
  OBSERVER
}

model Tenant {
  id        String     @id @default(uuid())
  parentId  String?
  parent    Tenant?    @relation("TenantTree", fields: [parentId], references: [id])
  children  Tenant[]   @relation("TenantTree")
  type      String     @default("INSTITUTION") // INSTITUTION | FACULTY | DEPARTMENT
  name      String
  config    Json       @default("{}")
  elections Election[]
  voters    Voter[]
}

model StaffUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  role         StaffRole
  passwordHash String
  createdAt    DateTime  @default(now())
}

model Voter {
  id             String          // matric / national ID within the tenant
  tenantId       String          @default("default")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  name           String
  email          String?
  phone          String?
  status         String          @default("ACTIVE")
  eligible       EligibleVoter[]
  participations Participation[]

  @@id([tenantId, id])
  @@index([tenantId])
}

model Election {
  id             String          @id @default(uuid())
  tenantId       String          @default("default")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  title          String
  description    String?
  mode           IntegrityMode
  state          ElectionState   @default(DRAFT)
  opensAt        DateTime?
  closesAt       DateTime?
  positions      Position[]
  eligible       EligibleVoter[]
  participations Participation[]
  sealed         Json?

  @@index([tenantId, state])
}

model Position {
  id             String          @id @default(uuid())
  electionId     String
  election       Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  title          String
  type           BallotType
  seats          Int             @default(1)
  allowAbstain   Boolean         @default(false)
  order          Int             @default(0)
  candidates     Candidate[]
  participations Participation[]

  @@index([electionId])
}

model Candidate {
  id         String   @id @default(uuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  name       String
  bio        String?
  status     String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  profile    Json     @default("{}")

  @@index([positionId])
}

model EligibleVoter {
  electionId String
  tenantId   String
  voterId    String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter      Voter    @relation(fields: [tenantId, voterId], references: [tenantId, id], onDelete: Cascade)

  @@id([electionId, tenantId, voterId])
  @@index([tenantId, voterId])
}

// Who voted on what position. Says nothing about the choice or ballot.
// Foreign keys link to Election, Position and composite Voter [tenantId, voterId].
// NO relation to Ballot, directly or indirectly.
model Participation {
  electionId String
  positionId String
  tenantId   String
  voterId    String

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  voter      Voter    @relation(fields: [tenantId, voterId], references: [tenantId, id], onDelete: Cascade)

  @@id([electionId, tenantId, voterId, positionId])
  @@index([electionId, tenantId, voterId])
}

// The anonymous ballot box.
// Hard anonymity rules:
// - NO voter reference
// - NO timestamp column (no createdAt, no updatedAt)
// Ballots are retrieved ordered by ballotHash, never insertion order.
model Ballot {
  id          String @id @default(uuid())
  electionId  String
  positionId  String
  payload     Json   // plain selection (Mode A) or ciphertext (Mode B)
  ballotHash  String @unique
  receiptHash String @unique

  @@index([electionId, positionId])
}

// Hash-chained audit log. Unique [electionId, seq] prevents chain forks.
model AuditLog {
  electionId String
  seq        Int
  prevHash   String
  hash       String
  event      String
  actor      String
  payload    Json
  at         DateTime

  @@id([electionId, seq])
  @@index([electionId])
}

// Revoked sessions for fast, durable sign-out verification.
model SessionRevocation {
  sid       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Durable voter OTP records: salt and SHA-256 hash only, never the plaintext code.
model OtpRecord {
  voterId   String   @id
  codeHash  String
  salt      String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
