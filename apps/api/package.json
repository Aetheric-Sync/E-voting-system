{
  "name": "@evote/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --prefix ../../packages/core && prisma generate",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --prefix ../../packages/core",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "OTP_ECHO=true tsx watch src/main.ts",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@evote/core": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.3",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
